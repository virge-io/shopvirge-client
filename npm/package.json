{
    "name": "@shopvirge/shopvirge-client",
    "version": "0.5.0",
    "description": "TypeScript client for the ShopVirge API, generated from its OpenAPI spec",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/virge-io/shopvirge-client.git",
        "directory": "npm"
    },
    "homepage": "https://github.com/virge-io/shopvirge-client/tree/main/npm#readme",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsup",
        "tsc": "tsc --noEmit",
        "lint": "eslint .",
        "prettier": "prettier --check .",
        "prettier-fix": "prettier --write .",
        "test": "vitest run",
        "generate": "prettier --write ../openapi.json && openapi-ts -i ../openapi.json -o src/api/generated && prettier --write src/api/generated",
        "generate:live": "node scripts/fetch-spec.mjs && pnpm generate && pnpm sync-version",
        "sync-version": "node scripts/sync-version.mjs",
        "check:generated": "pnpm generate && pnpm sync-version && git diff --exit-code -- ../openapi.json src/api/generated package.json",
        "prepublishOnly": "pnpm build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@hey-api/openapi-ts": "0.46.3",
        "@types/node": "^22.0.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.0.0",
        "globals": "^16.0.0",
        "prettier": "^3.0.0",
        "tsup": "^8.5.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.0.0",
        "vitest": "^4.1.0"
    },
    "packageManager": "pnpm@11.25.0"
}
